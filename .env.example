# Salin nilai ini ke Vercel: Project > Settings > Environment Variables
# (untuk uji lokal dengan Postgres, boleh dijadikan file .env dan diekspor ke terminal)

# Connection string PostgreSQL dari Neon/Supabase. Pakai versi "pooled" (host mengandung -pooler).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Kunci penanda tangan sesi login. Buat acak: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ganti-dengan-kunci-acak-panjang

# Kode rahasia untuk membuat password admin pertama kali (minimal 8 karakter). Jangan dibagikan.
SETUP_KEY=ganti-dengan-kode-rahasia

# --- Opsional: notifikasi push saat halaman ditutup. Buat dengan: python tools/buat_vapid.py ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@klinik-anda.example
